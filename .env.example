# Credentials for the local development database defined in docker-compose.yml.
# Copy to .env and adjust if needed. Development values only — never production.
POSTGRES_USER=juniorjob
POSTGRES_PASSWORD=juniorjob_dev_password
POSTGRES_DB=juniorjob

# Host port for the JuniorJob database. 5432 is taken on this machine by an
# unrelated PostgreSQL installation, so development uses 5433.
POSTGRES_HOST_PORT=5433
