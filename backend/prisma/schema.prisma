// JuniorJob AI — Prisma schema.
//
// Milestone M2.1 wired Prisma into the backend: datasource, generator, and the
// tooling to migrate and generate a client. The data model itself (docs/DATABASE.md)
// is added table-by-table in later milestones, per CLAUDE.md's rule to build only
// what a task asks for.
//
// This file currently holds:
//   - the M2.2 slice (docs/DATABASE.md §3.1): User, Profile, RefreshToken, UserRole —
//     the tables the M3 authentication module needs. `Profile.workplaceTypes` uses
//     WorkplaceType, defined here since it is otherwise unused until profiles (M3.6)
//     and job postings (M2.4) exist.
//   - the M2.3 slice (docs/DATABASE.md §3.2): JobSource, IngestionRun,
//     RawJobDocument, and the AccessMethod / IngestionStatus / IngestionTrigger
//     enums — the tables the Phase 5 ingestion pipeline writes into.
//   - the M2.4 slice (docs/DATABASE.md §3.3): JobPosting and Job — levels 2 and 3
//     of the three-level job model. EmploymentType is defined here because both
//     need it. No salary columns: D7 removed them from the design (§3.4).
//   - the M2.5 slice (docs/DATABASE.md §3.5): JobClassification and SavedJob, the
//     JuniorLevel enum, and Job's denormalized classification block — the block is
//     listed under §3.3 but lands with the classification rows that populate it.
//     This also unblocks `User.savedJobs`, deferred from M2.2 for want of SavedJob.
//     The partial unique index enforcing one current classification per job cannot
//     be expressed in Prisma; it is hand-written SQL in the M2.5 migration (§5).
//
// Deferred to M2.6, which adds the rest of the raw SQL Prisma cannot express (§5):
//   - `Job.searchVector` (generated tsvector) and its GIN index
//   - GIN indexes on `technologies`, the trigram index on `normalizedTitle`, the
//     partial active-search index, and the §5 CHECK constraints — including the
//     range checks over `Job.juniorScore` and `JobClassification.score`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum WorkplaceType {
  REMOTE
  ONSITE
  HYBRID
}

// Fixed by CLAUDE.md: must not be extended or renamed without a product decision
// (docs/DATABASE.md §3.6). Ordered from most to least suitable for a junior.
enum JuniorLevel {
  ENTRY_LEVEL
  LIKELY_ENTRY_LEVEL
  AMBIGUOUS
  EXPERIENCED
  CLEARLY_EXPERIENCED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
  WORKING_STUDENT
}

enum AccessMethod {
  PUBLIC_API
  PARTNER_API
  OFFICIAL_FEED
  DATA_AGREEMENT
  LICENSED_CONTENT
}

enum IngestionStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum IngestionTrigger {
  SCHEDULED
  MANUAL
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique // stored lowercased + trimmed
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  profile       Profile?
  savedJobs     SavedJob[]
  refreshTokens RefreshToken[]
}

model Profile {
  id                String          @id @default(uuid())
  userId            String          @unique
  displayName       String?
  yearsOfExperience Int             @default(0) // 0–2 for the target user
  desiredRoles      String[] // e.g. ["Java Developer"]
  technologies      String[] // canonical slugs — docs/DATABASE.md §6
  locations         String[] // free text
  countryCodes      String[] // ISO-3166 alpha-2
  workplaceTypes    WorkplaceType[]
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique // sha256 of the opaque token
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// accessMethod / termsUrl / attributionText record how a source may be used, per
// docs/ARCHITECTURE.md §7 — compliance stays auditable and the UI renders required
// attribution from data instead of hard-coding it per source.
model JobSource {
  id              String       @id @default(uuid())
  key             String       @unique // "example-source"
  displayName     String
  accessMethod    AccessMethod // compliance record, docs/ARCHITECTURE.md §7.1
  termsUrl        String?
  attributionText String? // rendered by the UI when set
  enabled         Boolean      @default(true)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)

  postings      JobPosting[]
  ingestionRuns IngestionRun[]
  rawDocuments  RawJobDocument[]
}

model IngestionRun {
  id           String           @id @default(uuid())
  sourceId     String
  trigger      IngestionTrigger @default(SCHEDULED)
  status       IngestionStatus
  startedAt    DateTime         @default(now()) @db.Timestamptz(3)
  finishedAt   DateTime?        @db.Timestamptz(3)
  fetched      Int              @default(0)
  created      Int              @default(0)
  updated      Int              @default(0)
  unchanged    Int              @default(0)
  duplicates   Int              @default(0)
  failed       Int              @default(0)
  errorMessage String?

  source       JobSource        @relation(fields: [sourceId], references: [id])
  rawDocuments RawJobDocument[]

  @@index([sourceId, startedAt(sort: Desc)])
  @@index([status, startedAt]) // find runs stuck in RUNNING
}

// contentHash is the change-detection key: re-fetching an unchanged listing writes
// no row, keeping storage proportional to changes rather than to fetches.
model RawJobDocument {
  id             String   @id @default(uuid())
  sourceId       String
  ingestionRunId String?
  externalId     String
  contentHash    String // sha256 of canonicalized payload
  payload        Json
  fetchedAt      DateTime @default(now()) @db.Timestamptz(3)

  source       JobSource     @relation(fields: [sourceId], references: [id])
  ingestionRun IngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([sourceId, externalId, contentHash]) // unchanged re-fetch ≠ new row
  @@index([sourceId, externalId, fetchedAt(sort: Desc)])
  @@index([fetchedAt]) // 90-day retention sweep
}

// Level 2 of the three-level job model (docs/ARCHITECTURE.md §5.1): one normalized
// listing per source. Users never read this directly, except for the source URLs on
// the job detail page. `jobId` stays null until dedup clusters the posting into a
// canonical Job, so ingestion can write a posting before dedup has run.
model JobPosting {
  id             String          @id @default(uuid())
  sourceId       String
  externalId     String // id within that source
  jobId          String? // canonical cluster; null until dedup
  url            String
  title          String
  companyName    String
  companySlug    String
  location       String?
  countryCode    String?         @db.Char(2)
  workplaceType  WorkplaceType?
  employmentType EmploymentType?
  language       String          @default("en") @db.Char(2) // ISO 639-1 — D3, §5.1
  description    String          @db.Text // normalized plain text
  contentHash    String // skip re-classify when unchanged
  technologies   String[]

  // lastSeenAt is written explicitly by ingestion, never @updatedAt: an unrelated
  // write must not make a stale posting look freshly observed (§3.3, §8).
  postedAt    DateTime? @db.Timestamptz(3)
  firstSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt  DateTime  @default(now()) @db.Timestamptz(3)
  isActive    Boolean   @default(true)

  source JobSource @relation(fields: [sourceId], references: [id])
  job    Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@unique([sourceId, externalId]) // dedup tier 1, idempotent re-ingestion
  @@index([jobId]) // job detail — "also listed on N sources"
  @@index([companySlug]) // dedup tier 3 candidate lookup
  @@index([sourceId, lastSeenAt]) // per-source staleness sweep
}

// Level 3: the canonical vacancy shown to users, clustering N postings. Salary is
// absent by decision (D7, §3.4) — salary text stays unparsed inside `description`.
model Job {
  id              String          @id @default(uuid())
  title           String
  normalizedTitle String // dedup tier 3 input; trigram index comes in M2.6
  companyName     String
  companySlug     String // dedup partition key + filtering
  location        String?
  countryCode     String?         @db.Char(2)
  workplaceType   WorkplaceType?
  employmentType  EmploymentType?
  language        String          @default("en") @db.Char(2)
  description     String          @db.Text
  technologies    String[]
  dedupHash       String          @unique // D1 — exact-match clustering key
  mergedIntoJobId String? // D2 — redirect after a merge

  // effectivePostedAt is non-null (coalesce of postedAt and firstSeenAt) so sorting
  // and pagination stay stable; postedAt is nullable because not every source
  // publishes one. lastSeenAt is set by ingestion, not @updatedAt — see JobPosting.
  postedAt          DateTime? @db.Timestamptz(3)
  effectivePostedAt DateTime  @db.Timestamptz(3)
  firstSeenAt       DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @db.Timestamptz(3)
  isActive          Boolean   @default(true)

  // Denormalized from the current JobClassification so search can filter and sort
  // without a join. juniorScore is a 0–100 *suitability* score, never a probability
  // of being hired (docs/DATABASE.md §4.2); its 0–100 CHECK arrives in M2.6 (§5).
  // requiredMinYears/requiredMaxYears back the maxYearsRequired search parameter.
  juniorLevel      JuniorLevel?
  juniorScore      Int?
  requiredMinYears Int?
  requiredMaxYears Int?
  classifiedAt     DateTime?    @db.Timestamptz(3)

  // Generated tsvector over title (weight A), companyName (B) and description
  // (C), stemmed with the German configuration when language = 'de' and English
  // otherwise (D3, docs/DATABASE.md §5.1). PostgreSQL maintains it; the
  // application never writes it. Prisma cannot express a generated column, so it
  // is raw SQL in M2.6's migration and is typed Unsupported here only so Prisma
  // knows the column exists and does not drop it. Read it with $queryRaw, always
  // under the same configuration the row was indexed with (§5).
  searchVector Unsupported("tsvector")?

  // A merged-away Job keeps its id and gains a redirect, so SavedJob rows stay
  // valid; search excludes it with `mergedIntoJobId IS NULL` (D2).
  mergedInto      Job?                @relation("JobMerge", fields: [mergedIntoJobId], references: [id])
  mergedFrom      Job[]               @relation("JobMerge")
  postings        JobPosting[]
  classifications JobClassification[]
  savedBy         SavedJob[]

  @@index([juniorLevel, effectivePostedAt(sort: Desc)]) // juniorLevel[] filter, recency sort
  @@index([juniorScore(sort: Desc), effectivePostedAt(sort: Desc)]) // minJuniorScore filter
  @@index([countryCode, workplaceType]) // location and workplace facet filtering
  @@index([companySlug, normalizedTitle]) // dedup tier 3 candidate narrowing
  @@index([lastSeenAt]) // staleness sweep

  // The three GIN indexes and the partial active-search index are created by
  // M2.6's raw SQL (docs/DATABASE.md §5, §7). They are declared here for the same
  // reason `searchVector` is typed Unsupported: without a declaration Prisma treats
  // them as drift and a later `migrate dev` emits DROP INDEX for all three. `map:`
  // pins the names the migration already created, so this describes them rather
  // than creating a second set.
  @@index([searchVector(ops: raw("tsvector_ops"))], type: Gin, map: "Job_searchVector_idx")
  @@index([technologies(ops: ArrayOps)], type: Gin, map: "Job_technologies_idx")
  @@index([normalizedTitle(ops: raw("gin_trgm_ops"))], type: Gin, map: "Job_normalizedTitle_trgm_idx")
}

// One classifier verdict for one job. Rows are never deleted: keeping every
// version's output is what lets a new classifier be evaluated against past jobs
// before it is promoted (docs/DATABASE.md §3.5).
//
// `inputHash` does double duty — it is the cache key that lets an unchanged
// description skip re-classification, and it is what allows a job whose text
// changed to hold both the old and the new result under one classifierVersion.
//
// Exactly one row per job carries isCurrent. Prisma cannot express a partial
// unique index, so `JobClassification_one_current_idx` is raw SQL in this
// milestone's migration (§5).
model JobClassification {
  id                String      @id @default(uuid())
  jobId             String
  classifierVersion String // "rules-1.0" | "llm-1.0"
  inputHash         String // hash of the classified text
  level             JuniorLevel
  score             Int // 0–100 suitability — never a probability of being hired (§4.2)
  minYears          Int? // experience requirement extracted from the description
  maxYears          Int?
  // Signal[] — { code, weight, evidence } per §4.1. Validated in code at the
  // classifier boundary, not by the database, and never queried independently,
  // which is why they are Json and carry no GIN index.
  positiveSignals   Json
  negativeSignals   Json
  summary           String? // short human explanation, shown on the job detail page
  isCurrent         Boolean     @default(true)
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, classifierVersion, inputHash])
  @@index([jobId, isCurrent]) // job detail evidence fetch
  @@index([classifierVersion, createdAt]) // offline evaluation of a version
}

// The only user↔job relation in the MVP; application tracking is out of scope
// (D7, §3.4). Pointing at Job rather than JobPosting is what keeps a save valid
// when dedup merges the job away — the redirect resolves it (D2).
model SavedJob {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  note      String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId]) // idempotent save, duplicate prevention
  @@index([userId, createdAt(sort: Desc)]) // /saved-jobs listing
}
