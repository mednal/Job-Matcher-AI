NODE_ENV=development
PORT=3000
# Comma-separated list of browser origins allowed to call this API.
# Add the port your frontend actually runs on, e.g.
# CORS_ORIGIN=http://localhost:4200,http://localhost:52562
CORS_ORIGIN=http://localhost:4200

# Local development database from the root docker-compose.yml.
# Host port 5433 — see the root .env.example for the credentials.
DATABASE_URL=postgresql://juniorjob:juniorjob_dev_password@localhost:5433/juniorjob?schema=public

# JWT signing secret. Required, at least 32 characters, no default — generate a
# real random value per environment, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace-with-a-random-32-byte-secret-per-environment
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Contact address embedded in the User-Agent of every job-source request
# (docs/ARCHITECTURE.md §7.3.2). https:// or mailto:. Point this at an address a
# human reads before fetching from any live source.
SOURCE_USER_AGENT_CONTACT=https://github.com/mednal/Job-Matcher-AI

# Rate limiting (docs/ARCHITECTURE.md §9). THROTTLE_LIMIT requests per IP per
# THROTTLE_TTL_SECONDS across the API, and THROTTLE_AUTH_LIMIT for /auth/*.
# Set THROTTLE_ENABLED=false only where something in front of the app already
# rate-limits.
THROTTLE_ENABLED=true
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=10
